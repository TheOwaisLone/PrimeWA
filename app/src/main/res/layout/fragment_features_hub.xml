<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <rikka.widget.borderview.BorderNestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingBottom="40dp">

            <!-- 1. Hero Module Status Banner (Dynamic Indicator: Green Tick / Red Cross / Yellow Info) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_radius_large"
                app:cardElevation="@dimen/card_elevation_high"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_primary"
                    android:orientation="vertical">

                    <!-- Header Row with Expand Dropdown Button -->
                    <RelativeLayout
                        android:id="@+id/status_card_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/spacing_large">

                        <ImageView
                            android:id="@+id/status_icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_centerVertical="true"
                            app:srcCompat="@drawable/ic_round_check_circle_24"
                            app:tint="@color/text_on_gradient"
                            tools:ignore="ContentDescription" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/spacing_medium"
                            android:layout_toStartOf="@+id/status_expand_icon"
                            android:layout_toEndOf="@id/status_icon"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/status_title"
                                style="@style/StatusCardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/module_enabled"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/status_summary"
                                style="@style/StatusCardSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/status_expand_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/text_on_gradient"
                            tools:ignore="ContentDescription" />

                    </RelativeLayout>

                    <!-- Collapsible Container for WhatsApp/Business Status and Supported Versions -->
                    <LinearLayout
                        android:id="@+id/status_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/spacing_large"
                        android:paddingBottom="@dimen/spacing_large"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="@dimen/spacing_medium"
                            android:background="@color/surface_glass_stroke" />

                        <!-- WhatsApp Active Status -->
                        <RelativeLayout
                            android:id="@+id/status2_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <ImageView
                                android:id="@+id/status_icon2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_round_check_circle_24"
                                app:tint="@color/text_on_gradient"
                                tools:ignore="ContentDescription" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_toStartOf="@+id/reboot_btn"
                                android:layout_toEndOf="@id/status_icon2"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/status_title2"
                                    style="@style/StatusCardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/whatsapp_in_background"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/status_summary1"
                                    style="@style/StatusCardSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/reboot_btn"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/circle_button_background"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="6dp"
                                android:src="@drawable/ic_reload"
                                app:tint="@color/text_on_gradient"
                                tools:ignore="ContentDescription" />

                        </RelativeLayout>

                        <!-- Business Active Status -->
                        <RelativeLayout
                            android:id="@+id/status3_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_medium">

                            <ImageView
                                android:id="@+id/status_icon3"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_round_check_circle_24"
                                app:tint="@color/text_on_gradient"
                                tools:ignore="ContentDescription" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_toStartOf="@+id/reboot_btn2"
                                android:layout_toEndOf="@id/status_icon3"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/status_title3"
                                    style="@style/StatusCardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/business_in_background"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/status_summary3"
                                    style="@style/StatusCardSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/reboot_btn2"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/circle_button_background"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="6dp"
                                android:src="@drawable/ic_reload"
                                app:tint="@color/text_on_gradient"
                                tools:ignore="ContentDescription" />

                        </RelativeLayout>

                        <!-- Supported Versions Block -->
                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Supported Version Ranges"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/list_wpp"
                            style="@style/StatusCardSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/list_business"
                            style="@style/StatusCardSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Native Ad Container -->
            <FrameLayout
                android:id="@+id/nativeAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:visibility="gone" />

            <!-- CARD 1: GENERAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_general_features"
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_general"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_general"
                        app:tint="@color/primary_color"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_toStartOf="@+id/arrow_general"
                        android:layout_toEndOf="@id/icon_general"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="0dp"
                            android:text="General"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Theme mode, Accent color preset, Updates check"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_general"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:rotation="-90"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: HOME SCREEN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_custom_features"
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_home_custom"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_home_black_24dp"
                        app:tint="@color/primary_color"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_toStartOf="@+id/arrow_home_custom"
                        android:layout_toEndOf="@id/icon_home_custom"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="0dp"
                            android:text="Home Screen"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pure messaging mode, Hide tabs, List animations, Custom CSS"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_home_custom"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:rotation="-90"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 3: CONVERSATION -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_conversation_features"
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_conversation"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary_color"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_toStartOf="@+id/arrow_conversation"
                        android:layout_toEndOf="@id/icon_conversation"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="0dp"
                            android:text="Conversation"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Group admin icons, Context menu UI, Scheduled messages, Chat analytics"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_conversation"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:rotation="-90"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 4: STATUS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status_features"
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_status_feat"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_round_update_24"
                        app:tint="@color/primary_color"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_toStartOf="@+id/arrow_status_feat"
                        android:layout_toEndOf="@id/icon_status_feat"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="0dp"
                            android:text="Status"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anti-delete status, Download status, IG stories mode, Custom text colors"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_status_feat"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:rotation="-90"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 5: PRIVACY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_privacy_features"
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_privacy"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_privacy"
                        app:tint="@color/primary_color"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_toStartOf="@+id/arrow_privacy"
                        android:layout_toEndOf="@id/icon_privacy"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="0dp"
                            android:text="Privacy"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ghost mode, Anti-revoke, Biometric Lock, Typing simulation"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_privacy"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:rotation="-90"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 6: CALLS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calls_features"
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_calls"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_general"
                        app:tint="@color/primary_color"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_toStartOf="@+id/arrow_calls"
                        android:layout_toEndOf="@id/icon_calls"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="0dp"
                            android:text="Calls"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Call blocker, Reject type (busy/ended), Contact whitelist &amp; blacklist"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_calls"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:rotation="-90"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 7: CUSTOMIZATION -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_customization_features"
                style="@style/CardInfoStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_custom"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_round_update_24"
                        app:tint="@color/primary_color"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_toStartOf="@+id/arrow_custom"
                        android:layout_toEndOf="@id/icon_custom"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="0dp"
                            android:text="Customization"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/StatusCardSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AMOLED pitch black, Custom background colors &amp; Monet dynamic themes"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow_custom"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
